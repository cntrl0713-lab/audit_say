{
  "name": "crimson-lagoon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.ts\"",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks')}catch(e){}\"",
    "questions:v3:validate": "tsx cpa_uploader/validate_cpa_v3.ts",
    "questions:v3:compile": "tsx --env-file=.env.local scripts/compile-question-bank-v3.ts",
    "questions:v3:db:check": "tsx scripts/import-question-bank-v3.ts",
    "questions:v3:db:import": "tsx --env-file=.env.local scripts/import-question-bank-v3.ts --apply",
    "learning:db:initialize": "tsx --env-file=.env.local scripts/initialize-learning-progress.ts --apply",
    "firm:collect:engagements": "tsx --env-file=.env.local scripts/firm_collector/run.ts engagements",
    "firm:collect:profiles": "tsx --env-file=.env.local scripts/firm_collector/run.ts firm-profiles",
    "firm:collect:annual": "tsx --env-file=.env.local scripts/firm_collector/run.ts annual-reports"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.0",
    "lucide-react": "^1.23.0",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
