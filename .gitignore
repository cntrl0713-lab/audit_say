# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# streamlit & python
.streamlit/
*.db
*.sqlite*
__pycache__/
*.py[cod]
*.venv
venv/
.venv/
env/
ENV/
.env.local

# claude runtime artifacts
.claude/*.lock

# OpenDART credential-free local replay cache
/.cache/firm_collector/

# Local reference clone and authoring scratch — not project source
/awesome-design-md/
/.hermes/

# Firm collector run dumps are regenerable output.
# The written summaries and the applied-write history stay tracked.
# Scoped to the collector's own output paths so hand-authored inputs
# elsewhere under docs/reports are not silently dropped.
/docs/reports/*.json
/docs/reports/annual/*.json
!/docs/reports/auditor-master-added.json
!/docs/reports/cpa-learning-db-applied.json
# 외부 기준서 원문은 로컬 참고용으로만 둔다
/docs/reports/question-review-2027/sources/

.vercel
.env*

# 원자적 쓰기가 남긴 조각. 정본은 확장자 없는 원본 파일이다.
**/*.tmp

# 배포·마이그레이션 작업 스크래치와 DB 스냅샷. 재생성 가능한 로컬 산출물이다.
/tmp/

# 외부 기준서 원문은 로컬 참고용으로만 둔다.
# docs/reports/.../sources/ 와 같은 이유이며, 인용은 문항·리뷰 문서에 남는다.
/cpa_uploader/data/official/

# 채점 하네스가 남긴 API 요청·응답 원문 로그. 하네스를 다시 돌리면 재생성된다.
# 하네스 스크립트와 케이스·판정 기록은 검토 근거라 추적한다.
/docs/reports/question-review-2027/grading-cases/*-live.jsonl
