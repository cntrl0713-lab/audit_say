# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# streamlit & python
.streamlit/
*.db
*.sqlite*
__pycache__/
*.py[cod]
*.venv
venv/
.venv/
env/
ENV/
.env.local

# claude runtime artifacts
.claude/*.lock

# OpenDART credential-free local replay cache
/.cache/firm_collector/

# Local reference clone and authoring scratch — not project source
/awesome-design-md/
/.hermes/

# Firm collector run dumps are regenerable output.
# The written summaries and the applied-write history stay tracked.
/docs/reports/**/*.json
!/docs/reports/auditor-master-added.json
# 외부 기준서 원문은 로컬 참고용으로만 둔다
/docs/reports/question-review-2027/sources/
