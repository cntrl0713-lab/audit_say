# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# streamlit & python
.streamlit/
*.db
*.sqlite*
__pycache__/
*.py[cod]
*.venv
venv/
.venv/
env/
ENV/
.env.local

# claude runtime artifacts
.claude/*.lock

# OpenDART credential-free local replay cache
/.cache/firm_collector/

# Firm collector run dumps are regenerable output.
# The written summaries and the applied-write history stay tracked.
# Scoped to the collector's own output paths so hand-authored inputs
# elsewhere under docs/reports are not silently dropped.
/docs/reports/*.json
/docs/reports/annual/*.json
!/docs/reports/auditor-master-added.json
!/docs/reports/cpa-learning-db-applied.json
# 외부 기준서 원문은 로컬 참고용으로만 둔다
/docs/reports/question-review-2027/sources/
/cpa_uploader/analysis/reviews/question-review-2027/sources/*
# 이전 전부터 추적하던 두 근거 파일은 새 위치에서도 추적한다.
!/cpa_uploader/analysis/reviews/question-review-2027/sources/fsc-2027-scope.pdf
!/cpa_uploader/analysis/reviews/question-review-2027/sources/kicpa-list.html

.vercel
.env*

# 원자적 쓰기가 남긴 조각. 정본은 확장자 없는 원본 파일이다.
**/*.tmp

# 배포·마이그레이션 작업 스크래치와 DB 스냅샷. 재생성 가능한 로컬 산출물이다.
/tmp/

# 외부 기준서 원문은 로컬 참고용으로만 둔다.
# docs/reports/.../sources/ 와 같은 이유이며, 인용은 문항·리뷰 문서에 남는다.
/cpa_uploader/data/official/

# raw 원본·보존 사본은 로컬 참고용. 수집 목록과 절차만 추적한다.
/cpa_uploader/raw/materials/
/cpa_uploader/raw/originals/

# 채점 API 요청·응답 원문 로그는 로컬 기록으로만 둔다.
# 케이스·판정 기록은 검토 근거로 추적한다.
/docs/reports/question-review-2027/grading-cases/*-live.jsonl
/cpa_uploader/analysis/reviews/question-review-2027/grading-cases/*-live.jsonl

# 초안 배치에 함께 내려받은 서드파티 도구(vendored pip 패키지 등). 저작물이 아니라
# 로컬 추출 작업에 쓰인 도구이며 필요하면 다시 설치할 수 있다.
/cpa_uploader/drafts/**/tools/python/
