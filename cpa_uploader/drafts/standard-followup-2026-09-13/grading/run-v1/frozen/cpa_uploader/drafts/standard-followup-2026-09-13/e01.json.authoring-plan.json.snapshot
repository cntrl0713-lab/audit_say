      "objective": "비인증업무 성공보수의 위협과 안전장치",
      "scope": {
        "actors": [
          "감사인 또는 개업공인회계사; 발문에 명시한 경영진·지배기구·의뢰인"
        ],
        "timing": [
          "비인증업무 성공보수의 윤리적 위협을 평가·대응하는 때"
        ],
        "conditions": [
          "공인회계사윤리기준 문단 240.3에 따라 일부 비인증업무를 성공보수 조건으로 수임할 때 발생할 수 있는 위협의 종류와 위협받는 윤리강령을 제시하시오. 이어 해당 위협의 중요성을 결정하는 데 예시된 네 가지 요인을 모두 제시하시오. 감사·인증업무의 성공보수 허용 여부나 특정 고객에 대한 별도 금지규정은 묻지 않는다.",
          "비인증업무의 성공보수와 관련된 윤리적 위협이 명백하게 경미하지 않은 경우, 공인회계사윤리기준 문단 240.4에 예시된 네 가지 안전장치를 모두 설명하시오. 사전동의의 대상·형식·시점과 업무결과 예정이용자에게 제공할 두 가지 정보도 포함하시오. 다른 규정에서 금지한 업무를 이 안전장치만으로 허용할 수 있다는 의미는 아니다."
        ],
        "exceptions": [
          "각 발문에 명시된 일반 조건·예외 및 조치의 선택 가능성을 보존한다."
        ],
        "required_answers": [
          "이기적 위협이 발생할 수 있다.",
          "공정 강령의 준수가 위협받을 수 있다.",
          "업무의 성격을 고려한다.",
          "보수의 범위를 고려한다.",
          "보수의 산정기준을 고려한다.",
          "해당 거래의 산출물이나 결과를 독립적인 제3자가 검토하는지 고려한다.",
          "보수의 산정근거에 관하여 의뢰인에게 서면으로 사전동의를 받는다.",
          "업무결과의 예정이용자에게 수행한 업무의 내용을 제시한다.",
          "업무결과의 예정이용자에게 보수의 산정근거를 제시한다.",
          "품질관리 정책과 절차를 적용한다.",
          "수행한 업무를 객관적인 제3자가 검토하도록 한다."
        ],
        "exclusions": [
          "감사·인증업무의 성공보수 허용 여부 및 감사고객에 대한 별도 금지요건은 제외. 일반 안전장치로 금지업무까지 허용된다고 해석하지 않음"
        ]
      },
