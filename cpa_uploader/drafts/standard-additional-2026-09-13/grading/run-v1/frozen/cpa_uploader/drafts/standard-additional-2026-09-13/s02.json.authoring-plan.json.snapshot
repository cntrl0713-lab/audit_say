  "plans": [
    {
      "set_id": "draft-standard-additional-20260913-s02",
      "version": 1,
      "topic_id": "03",
      "mode": "new_from_standard",
      "objective": "재무보고체계의 수용가능성과 법정 보고서",
      "scope": {
        "actors": [
          "감사인 또는 개업공인회계사; 발문에 명시한 경영진·지배기구·의뢰인"
        ],
        "timing": [
          "감사업무 수임 시 재무보고체계·법정 보고서의 평가"
        ],
        "conditions": [
          "감사기준서 210 문단 A4에서 재무제표 작성에 적용되는 재무보고체계의 수용가능성을 결정할 때 고려하도록 제시한 네 가지 요인을 모두 설명하시오. 기업의 성격, 재무제표의 목적과 성격은 각기 무엇을 구별하는지 예시 또는 동등한 설명을 포함하시오.",
          "법규에 의해 규정되었다는 사실을 제외하면 수용가능하지 않았을 재무보고체계에 관하여, 감사기준서 210 문단 19의 감사업무 수임조건을 모두 설명하시오. 경영진의 추가 공시와 업무조건에서 인정할 보고사항 및 의견 문구의 법규상 예외를 포함하시오. 이어 이러한 조건이 없으나 법규가 감사수행을 강제할 때 문단 20에 따라 취할 두 조치를 제시하시오.",
          "법규가 감사기준의 요구사항과 유의적으로 다른 형태·용어의 감사보고서를 규정할 때, 감사기준서 210 문단 21에 따라 감사인이 평가할 두 사항을 제시하시오. 추가 설명으로 오해 가능성을 완화할 수 없다고 결론 내린 경우의 수임 원칙과 법규상 예외, 그 예외로 수행한 감사의 감사기준 준수 여부 및 감사보고서의 준수 언급 가능 여부도 설명하시오."
        ],
        "exceptions": [
          "각 발문에 명시된 일반 조건·예외 및 조치의 선택 가능성을 보존한다."
        ],
        "required_answers": [
          "기업의 성격을 고려한다. 예를 들어 영리기업·공공부문·비영리조직인지 구별한다.",
          "재무제표의 목적을 고려한다. 광범위한 이용자의 공통 정보수요를 충족하는지 또는 특정 이용자의 정보수요를 위한 것인지 구별한다.",
          "재무제표의 성격을 고려한다. 예를 들어 전체재무제표인지 단위재무제표인지 구별한다.",
          "해당 재무보고체계가 법규에 규정되어 있는지 고려한다.",
          "재무제표가 오도하지 않도록 경영진이 추가적인 공시를 제공하기로 동의해야 한다.",
          "감사업무 조건에서 추가 공시에 이용자의 주의를 환기시키는 강조사항문단을 감사보고서에 포함할 것임을 인정해야 한다.",
          "법규가 요구하는 경우가 아니면 감사의견에 “중요성의 관점에서 공정하게 표시하고 있다” 또는 “진실하고 공정한 관점을 제시하고 있다”라는 문구를 포함하지 않을 것임을 업무조건에서 인정해야 한다.",
          "수임조건이 없으나 법규가 감사수행을 강제하면 재무제표의 오도하는 성격이 감사보고서에 미치는 영향을 평가한다.",
          "그 강제수행 상황의 사항을 감사업무 조건에 적합하게 언급한다.",
          "이용자가 재무제표감사에서 얻은 확신을 오해할 가능성이 있는지 평가한다.",
          "그렇다면 감사보고서의 추가적인 설명으로 오해 가능성을 완화할 수 있는지 평가한다.",
          "추가 설명으로 오해 가능성을 완화할 수 없으면 법규에서 요구하는 경우를 제외하고 감사업무를 수임해서는 안 된다.",
          "그와 같은 법규에 따라 수행되는 감사는 감사기준을 준수하는 감사가 아니다.",
          "따라서 감사보고서에 감사가 감사기준에 따라 수행되었다는 어떠한 언급도 해서는 안 된다."
        ],
        "exclusions": [
          "합리적 정당성에 따른 업무변경 및 일반 감사계약서 항목 열거는 제외"
        ]
      },
