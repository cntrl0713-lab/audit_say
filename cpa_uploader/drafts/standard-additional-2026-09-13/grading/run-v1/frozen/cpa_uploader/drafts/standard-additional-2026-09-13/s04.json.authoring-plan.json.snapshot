      "objective": "특수관계자 통제 이해와 비경상거래 탐색",
      "scope": {
        "actors": [
          "감사인 또는 개업공인회계사; 발문에 명시한 경영진·지배기구·의뢰인"
        ],
        "timing": [
          "위험평가에서 특수관계·거래의 통제를 이해하거나 정상 사업과정 밖 유의적 거래를 식별한 때"
        ],
        "conditions": [
          "감사기준서 550 문단 14에 따라 경영진이 관련 통제를 수립해 둔 경우, 감사인이 이해할 통제의 세 목적 범주를 모두 제시하시오. 한 범주에 여러 기능이 제시되어 있으면 모두 포함하고, 권한부여·승인 범주는 그 대상 거래·약정을 구별하시오. 이어 그 통제를 이해하기 위해 수행할 두 종류의 절차도 설명하시오.",
          "감사인이 정상적인 사업과정을 벗어난 유의적 거래를 식별했지만 아직 특수관계자 거래인지는 확인되지 않았다. 감사기준서 550 문단 16에 따라 경영진에게 질문할 두 사항을 제시하시오. 이어 해당 기업의 특수관계자에 관하여 입수한 관련 정보는 문단 17에 따라 누구와 어떻게 다루어야 하는지 설명하시오."
        ],
        "exceptions": [
          "각 발문에 명시된 일반 조건·예외 및 조치의 선택 가능성을 보존한다."
        ],
        "required_answers": [
          "해당 재무보고체계에 따른 특수관계 및 특수관계자 거래의 식별을 위한 통제를 이해한다.",
          "해당 재무보고체계에 따른 특수관계 및 특수관계자 거래의 회계처리를 위한 통제를 이해한다.",
          "해당 재무보고체계에 따른 특수관계 및 특수관계자 거래의 공시를 위한 통제를 이해한다.",
          "특수관계자와의 유의적 거래·약정에 대한 권한부여와 승인 통제를 이해한다.",
          "정상적인 사업과정을 벗어난 유의적 거래·약정에 대한 권한부여와 승인 통제를 이해한다.",
          "그 통제를 이해하기 위해 경영진 및 기업 내부의 다른 사람에게 질문한다.",
          "적절하다고 고려되는 기타 위험평가절차를 수행한다.",
          "해당 거래의 성격에 대하여 경영진에게 질문한다.",
          "특수관계자가 그 거래에 관여할 가능성에 대하여 경영진에게 질문한다.",
          "기업의 특수관계자에 관하여 입수한 관련 정보를 업무팀의 다른 구성원과 공유한다."
        ],
        "exclusions": [
          "이미 특수관계자 거래로 식별된 거래의 계약·승인 증거 평가와 미공개 거래 발견 후 전체 대응은 제외"
        ]
      },
