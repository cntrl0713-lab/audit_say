#!/bin/sh
# Pre-commit gate: block the commit if types, tests, analysis/evidence, or wiki checks fail.
# Purpose: catch regressions at commit time, not later at review.
#   - typecheck catches type/shape/signature mismatches (e.g. R2: string passed as a numeric id).
#   - tests catch type-valid logic bugs (e.g. R1: matching by array index instead of question id).
# This is enforcement by tool, not by prompt.

echo "> Gate 1/4: typecheck (npm run typecheck)..."
npm run typecheck --silent
if [ $? -ne 0 ]; then
  echo "x Typecheck FAILED - commit blocked. Fix the type errors above, then re-commit."
  echo "  (Bypass in a genuine emergency only: git commit --no-verify)"
  exit 1
fi
echo "v Typecheck passed."

echo "> Gate 2/4: tests (npm test)..."
npm test --silent
if [ $? -ne 0 ]; then
  echo "x Tests FAILED - commit blocked. Fix the failing tests above, then re-commit."
  echo "  (Bypass in a genuine emergency only: git commit --no-verify)"
  exit 1
fi
echo "v Tests passed."
echo "> Gate 3/4: analysis synchronization and historical evidence (npm run analysis:check)..."
npm run analysis:check --silent
if [ $? -ne 0 ]; then
  echo "x Analysis check FAILED - review the changed inputs, regenerate analysis, and preserve historical evidence."
  exit 1
fi
echo "v Analysis synchronization passed."

echo "> Gate 4/4: wiki synchronization (npm run wiki:check)..."
npm run wiki:check --silent
if [ $? -ne 0 ]; then
  echo "x Wiki check FAILED - commit blocked. Run npm run wiki:build, review the changes, and stage the updated wiki."
  exit 1
fi
echo "v Wiki synchronization passed."
exit 0
